# Copia este archivo a .env y ajusta lo que necesites.

# Puerto del minipc donde se publica la web (http://IP-DEL-MINIPC:8080)
PORT=8080

TZ=Europe/Madrid

# Déjalo vacío para no pedir contraseña (bien si solo se usa dentro de casa).
# Ponle valor si vas a acceder desde fuera de tu red.
AUTH_USER=
AUTH_PASSWORD=
